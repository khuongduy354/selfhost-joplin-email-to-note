# ============================================
# Joplin Email To Note - Environment Variables
# ============================================
# Copy this file to .env and fill in your credentials

# Which sync target to use: JoplinServer | WebDAV | OneDrive | GoogleDrive
SYNC_TARGET=JoplinServer

# ============================================
# Joplin Server
# ============================================
JOPLIN_SERVER_URL=http://localhost:22300
JOPLIN_SERVER_USERNAME=admin@localhost
JOPLIN_SERVER_PASSWORD=admin

# ============================================
# WebDAV (Nextcloud, ownCloud, etc.)
# ============================================
WEBDAV_URL=https://your-nextcloud.com/remote.php/dav/files/username/Joplin
WEBDAV_USERNAME=your_username
WEBDAV_PASSWORD=your_password

# ============================================
# OneDrive (requires OAuth)
# ============================================
ONEDRIVE_CLIENT_ID=your_azure_app_client_id
ONEDRIVE_CLIENT_SECRET=your_azure_app_client_secret
ONEDRIVE_AUTH_TOKEN={"access_token":"...","refresh_token":"...","token_type":"Bearer","expires_in":3600}

# ============================================
# Google Drive (requires OAuth)
# ============================================
GOOGLEDRIVE_CLIENT_ID=your_google_client_id
GOOGLEDRIVE_CLIENT_SECRET=your_google_client_secret
GOOGLEDRIVE_AUTH_TOKEN={"access_token":"...","refresh_token":"...","token_type":"Bearer","expires_in":3600}

# ============================================
# Target Notebook (optional)
# ============================================
# Parent folder ID in Joplin where notes will be created
# Leave empty to use root notebook
JOPLIN_PARENT_FOLDER_ID=
